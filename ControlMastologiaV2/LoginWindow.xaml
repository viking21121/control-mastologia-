<Window x:Class="ControlMastologiaV2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenida" Height="450" Width="400" WindowState="Maximized">
    


        <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="🏥" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Text="Control Mastología" FontSize="24" FontWeight="Bold" Foreground="#2c3e50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="Introduzca Contraseña para ingresar:" Margin="0,0,0,5" HorizontalAlignment="Center"/>

        <PasswordBox x:Name="txtPass" Height="35" Margin="0,0,0,10"/>

        <Button Content="Ingresar al Sistema" Click="BtnIngresar_Click" Height="40" Background="#3498db" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
</Window>